{
  "kind": "StatefulSet",
  "id": "ci",
  "image": "liferaycloud/jenkins:2.479.2-lts-jdk21-6.0.0",
  "deploy": false,
  "memory": 8192,
  "cpu": 4,
  "scale": 1,
  "volumes": {
    "ciData": "/var/jenkins_home"
  },
  "loadBalancer": {
    "targetPort": 8080
  },
  "readinessProbe": {
    "httpGet": {
      "path": "/login",
      "port": 8080
    },
    "initialDelaySeconds": 60,
    "timeoutSeconds": 10,
    "failureThreshold": 12
  },
  "livenessProbe": {
    "httpGet": {
      "path": "/login",
      "port": 8080
    },
    "initialDelaySeconds": 300,
    "timeoutSeconds": 10,
    "failureThreshold": 12
  },
  "env": {
    "JENKINS_ADMIN_USER_NAME": "lctmisaellatest",
    "JENKINS_URL": "https://ci-lctmisaellatest-infra.lfr.cloud",
    "LCP_CI_DEPLOY_TARGET": "dev",
    "LCP_CI_SCM_REPOSITORY_NAME": "producthub",
    "LCP_CI_SCM_REPOSITORY_OWNER": "misaellr",
    "LCP_CI_GRADLE_JDK": "jdk21"
  },
  "environments": {
    "infra": {
      "deploy": true
    }
  }
}
